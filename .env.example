# Server-only Functions variables. Never use a VITE_ prefix for credentials.
# Safe defaults: no live sends until ALL required settings are present.
WHATSAPP_SEND_ENABLED=false
RELAY_ASYNC_READY=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
# Pin a supported Graph version after checking Meta docs, format vNN.0.
WHATSAPP_API_VERSION=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Conservative global concurrency is fixed at 1. Interval: 1000..30000 ms.
RELAY_SEND_INTERVAL_MS=2000
# Max recipients per workload invocation: 1..10. Also bounded by 35-second loop budget.
RELAY_BATCH_SIZE=5
# Netlify supplies CONTEXT. Live delivery requires CONTEXT=production.
# Do not override CONTEXT in local/demo/preview to enable delivery.
# Async Workloads extension manages AWL_API_KEY and routing configuration.
