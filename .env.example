# Server-only Functions environment variables. Never prefix credentials with VITE_.
# Phase 3 reads templates only. This release has no sending endpoint.
WHATSAPP_SEND_ENABLED=false
# Required for real template synchronization (not used by local demo).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Explicit supported Graph version, format vNN.0; verify against Meta docs.
WHATSAPP_API_VERSION=
# Reserved for Phase 4 sending and signed webhooks.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
