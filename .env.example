# Phase 1 has no real sending implementation. Never prefix secrets with VITE_.
WHATSAPP_SEND_ENABLED=false
# Configure these only when implementing Phase 4, in Netlify Functions scope.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# Pin a supported Graph API version after verifying Meta's current documentation.
WHATSAPP_API_VERSION=
